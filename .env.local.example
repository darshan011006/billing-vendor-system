# Copied to .env.local automatically on the first `npm run dev`.

# PostgreSQL and MongoDB. By default `npm run dev` starts its own copies on these ports.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/billing_vendor_db
MONGODB_URI=mongodb://127.0.0.1:27018/billing_notifications

# Set USE_EMBEDDED_DB=false to use a PostgreSQL / MongoDB you installed yourself
# (then point the two URLs above at them).
USE_EMBEDDED_DB=true

# Signs login sessions. Generated for you on first run.
JWT_SECRET=change-me

# WhatsApp Business Cloud API. Leave empty for demo mode: messages are logged to
# MongoDB and printed in the terminal, and the login OTP is shown on screen.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_LANGUAGE=en
